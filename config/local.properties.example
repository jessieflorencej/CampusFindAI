# Use this only when connecting to your own existing MySQL instance.
# Copy to config/local.properties and enter your database account.
spring.datasource.url=jdbc:mysql://localhost:3306/campus_lost_found?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=campus_app
spring.datasource.password=REPLACE_WITH_YOUR_PASSWORD
